      "frontmatter": "import BaseLayout from '../layouts/BaseLayout.astro';\nimport Header from '../components/Header.astro';\nimport Footer from '../components/Footer.astro';\nimport Hero from '../components/Hero.astro';\nimport TrustBar from '../components/TrustBar.astro';\nimport Services from '../components/Services.astro';\nimport About from '../components/About.astro';\nimport Reviews from '../components/Reviews.astro';\nimport Gallery from '../components/Gallery.astro';\nimport CTA from '../components/CTA.astro';\nimport { brand } from '../config/brand';\nimport { client } from '../data/client';",
      "file": "own"
    },
    "reviews": {
      "route": "reviews",
      "title": "Reviews",
      "root": [
        {
          "id": "r-code-19",
          "tag": "astro-code",
          "attrs": {
            "builder-data-element": "code",
            "data-open": "<BaseLayout\n  title=\"Reviews\"\n  description={`Read what customers say about working with ${brand.name}.`}\n>",
            "data-close": "</BaseLayout>"
          },
          "children": [
            {
              "id": "r-code-y",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Header slot=\"header\" />"
            },
            {
              "id": "r-code-z",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Banner title=\"Customer Reviews\" />"
            },
            {
              "id": "r-section-10",
              "tag": "section",
              "classes": [
                "py-section"
              ],
              "children": [
                {
                  "id": "r-code-30q",
                  "tag": "astro-code",
                  "attrs": {
                    "builder-data-element": "code"
                  },
                  "children": [],
                  "html": "<div class=\"mx-auto max-w-site px-4 sm:px-6\">\n      <div class=\"mx-auto mb-10 max-w-2xl text-center lg:mb-14\">\n        <h2 class=\"font-heading text-h2 font-bold uppercase text-text\">What people are saying</h2>\n        <p class=\"mt-3 text-text-muted leading-relaxed\">\n          Don't take our word for it — hear from the people we work with.\n        </p>\n      </div>\n\n      {reviews.length > 0 ? (\n      <div class=\"grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3\">\n        {reviews.map(({ quote, name, location, rating = 5 }) => (\n          <div class=\"flex flex-col rounded-lg border border-border bg-background p-6 shadow-sm\">\n            <div class=\"mb-4 flex gap-0.5\" aria-label={`Rated ${rating} out of 5 stars`}>\n              {Array.from({ length: 5 }).map((_, i) => (\n                <svg\n                  class:list={['size-5', i < rating ? 'text-accent' : 'text-border']}\n                  fill=\"currentColor\"\n                  viewBox=\"0 0 20 20\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                </svg>\n              ))}\n            </div>\n            <blockquote class=\"flex-1 text-text-muted leading-relaxed\">\n              &ldquo;{quote}&rdquo;\n            </blockquote>\n            <div class=\"mt-4 border-t border-border pt-4\">\n              <p class=\"font-semibold text-text\">{name}</p>\n              <p class=\"text-sm text-text-muted\">{location}</p>\n            </div>\n          </div>\n        ))}\n      </div>\n      ) : (\n      <div class=\"mx-auto max-w-xl rounded-lg border border-border bg-surface p-8 text-center\">\n        <p class=\"text-text-muted leading-relaxed\">\n          We're in the process of collecting testimonials from the manufacturers\n          and distributors we represent. In the meantime, you can read what\n          people say about us on Google.\n        </p>\n        <div class=\"mt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-center\">\n          <a\n            href={client.socials.google}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            class=\"inline-flex min-h-[44px] items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary\"\n          >\n            Read our Google reviews\n          </a>\n          <a\n            href=\"/contact\"\n            class=\"inline-flex min-h-[44px] items-center justify-center rounded-md border-2 border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg\"\n          >\n            Work with us\n          </a>\n        </div>\n      </div>\n      )}\n    </div>"
                }
              ]
            },
            {
              "id": "r-code-17",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<CTA />"
            },
            {
              "id": "r-code-18",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Footer slot=\"footer\" />"
            }
          ]
        }
      ],
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": []
        }
      ],
      "frontmatter": "import BaseLayout from '../layouts/BaseLayout.astro';\nimport Header from '../components/Header.astro';\nimport Footer from '../components/Footer.astro';\nimport Banner from '../components/Banner.astro';\nimport CTA from '../components/CTA.astro';\nimport { brand } from '../config/brand';\nimport { client } from '../data/client';\n\n/**\n * Reviews\n *\n * The template shipped with six invented testimonials and an aggregateRating\n * built from them. Publishing fabricated review data is a real exposure under\n * Google's structured-data policy and FTC endorsement rules, so both are gone.\n *\n * To restore this page: add real, attributable quotes to `reviews` below. Only\n * re-add aggregateRating schema once the ratings it reports are genuine.\n */\ninterface Review {\n  quote: string;\n  name: string;\n  location: string;\n  rating?: number;\n}\n\nconst reviews: Review[] = [];",
      "file": "own"
    },
    "services": {
      "route": "services",
      "title": "Services",
      "root": [
        {
          "id": "r-code-1l",
          "tag": "astro-code",
          "attrs": {
            "builder-data-element": "code",
            "data-open": "<BaseLayout title=\"Services\" description={`How ${brand.name} supports manufacturers, distributors and end users across the mid to southern Atlantic and Gulf Coast.`}>",
            "data-close": "</BaseLayout>"
