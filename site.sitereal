      "frontmatter": "import BaseLayout from '../layouts/BaseLayout.astro';\nimport Header from '../components/Header.astro';\nimport Footer from '../components/Footer.astro';\nimport Banner from '../components/Banner.astro';\nimport CTA from '../components/CTA.astro';\nimport { Image } from 'astro:assets';\nimport { brand } from '../config/brand';\n\nconst team = [\n  { name: 'John Smith',   role: 'Founder & Lead Technician', image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80' },\n  { name: 'Maria Garcia', role: 'Operations Manager',        image: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80' },\n  { name: 'David Chen',   role: 'Senior Technician',         image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80' },\n];",
      "file": "own"
    },
    "blog/index": {
      "route": "blog/index",
      "title": "Index",
      "root": [
        {
          "id": "r-code-3e",
          "tag": "astro-code",
          "attrs": {
            "builder-data-element": "code",
            "data-open": "<BaseLayout title=\"Blog\" description={`Tips, guides, and news from ${brand.name}. Stay informed about home maintenance and improvement.`}>",
            "data-close": "</BaseLayout>"
          },
          "children": [
            {
              "id": "r-code-37",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Header slot=\"header\" />"
            },
            {
              "id": "r-code-38",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Banner title=\"Blog\" />"
            },
            {
              "id": "r-section-39",
              "tag": "section",
              "classes": [
                "py-section"
              ],
              "children": [
                {
                  "id": "r-code-3b",
                  "tag": "astro-code",
                  "attrs": {
                    "builder-data-element": "code"
                  },
                  "children": [],
                  "html": "<div class=\"mx-auto max-w-site px-4 sm:px-6\">\n      {posts.length === 0 ? (\n        <p class=\"text-center text-text-muted\">No posts yet. Check back soon!</p>\n      ) : (\n        <div class=\"grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3\">\n          {posts.map((post) => {\n            const formattedDate = post.data.date.toLocaleDateString('en-US', {\n              year: 'numeric',\n              month: 'long',\n              day: 'numeric',\n            });\n            return (\n              <article class=\"group flex flex-col overflow-hidden rounded-lg border border-border bg-background shadow-sm transition-shadow hover:shadow-md\">\n                <div class=\"flex flex-1 flex-col p-6\">\n                  <div class=\"flex items-center gap-2 text-sm text-text-muted\">\n                    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>\n                    {post.data.tags.length > 0 && (\n                      <>\n                        <span aria-hidden=\"true\">&bull;</span>\n                        <span>{post.data.tags[0]}</span>\n                      </>\n                    )}\n                  </div>\n                  <h2 class=\"mt-3 font-heading text-h3 font-semibold text-text group-hover:text-primary transition-colors\">\n                    <a href={`/blog/${post.id}`} class=\"after:absolute after:inset-0 relative\">\n                      {post.data.title}\n                    </a>\n                  </h2>\n                  <p class=\"mt-2 flex-1 text-sm leading-relaxed text-text-muted\">\n                    {post.data.description}\n                  </p>\n                  <span class=\"mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary\">\n                    Read more\n                    <svg class=\"size-4 transition-transform group-hover:translate-x-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5l7 7-7 7\" />\n                    </svg>\n                  </span>\n                </div>\n              </article>\n            );\n          })}\n        </div>\n      )}\n    </div>"
                }
              ]
            },
            {
              "id": "r-code-3c",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<CTA />"
            },
            {
              "id": "r-code-3d",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Footer slot=\"footer\" />"
            }
          ]
        }
      ],
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": []
        }
      ],
      "frontmatter": "import BaseLayout from '../../layouts/BaseLayout.astro';\nimport Header from '../../components/Header.astro';\nimport Footer from '../../components/Footer.astro';\nimport Banner from '../../components/Banner.astro';\nimport CTA from '../../components/CTA.astro';\nimport { getCollection } from 'astro:content';\nimport { brand } from '../../config/brand';\n\nconst posts = (await getCollection('blog', ({ data }) => !data.draft))\n  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());",
      "file": "own"
    },
