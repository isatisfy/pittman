            "data-open": "<BaseLayout\n  title=\"Reviews\"\n  description={`Read reviews and testimonials from ${brand.name} customers. See why homeowners trust us for their projects.`}\n  schema={{\n    '@context': 'https://schema.org',\n    '@type': 'LocalBusiness',\n    name: client.name,\n    aggregateRating: {\n      '@type': 'AggregateRating',\n      ratingValue: '5',\n      reviewCount: String(reviews.length),\n      bestRating: '5',\n    },\n  }}\n>",
