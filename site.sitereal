        }
      ],
      "frontmatter": "import { Image } from 'astro:assets';\nimport type { ImageMetadata } from 'astro';\nimport { brand } from '../config/brand';\nimport { client } from '../data/client';\nimport { heroImage as localHeroImage } from '../config/images';\n\n// Fallback Unsplash URL used until a local image is added to\n// src/assets/images/hero/ and registered in src/config/images.ts\nconst PLACEHOLDER = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80';\n\ninterface Props {\n  topper?: string;\n  heading?: string;\n  description?: string;\n  ctaLabel?: string;\n  ctaHref?: string;\n  secondaryLabel?: string;\n  secondaryHref?: string;\n  imageSrc?: ImageMetadata | string;\n  imageAlt?: string;\n}\n\nconst {\n  topper = 'Manufacturers Representative',\n  heading = brand.tagline,\n  description = brand.description,\n  ctaLabel = 'Request a Quote',\n  ctaHref = '/contact',\n  secondaryLabel = 'Our Services',\n  secondaryHref = '/services',\n  imageSrc = localHeroImage ?? PLACEHOLDER,\n  imageAlt = '5-axis machining center in operation',\n} = Astro.props;",
      "props": [
        {
          "name": "topper",
          "type": "text",
          "value": "Manufacturers Representative"
        },
        {
          "name": "heading",
          "type": "text",
          "value": "brand.tagline"
        },
        {
          "name": "description",
          "type": "text",
          "value": "brand.description"
        },
        {
          "name": "ctaLabel",
          "type": "text",
          "value": "Request a Quote"
        },
        {
          "name": "ctaHref",
          "type": "text",
          "value": "/contact"
        },
        {
          "name": "secondaryLabel",
          "type": "text",
          "value": "Our Services"
        },
        {
          "name": "secondaryHref",
          "type": "text",
          "value": "/services"
        },
        {
          "name": "imageSrc",
          "type": "object",
          "value": "localHeroImage ?? PLACEHOLDER"
        },
        {
          "name": "imageAlt",
          "type": "text",
          "value": "5-axis machining center in operation"
        }
      ],
      "stylesheets": [
        {
          "id": "cmpcss-sheet-mwi3cof5-3",
          "name": "Hero",
          "rules": []
