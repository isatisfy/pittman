                      "id": "r-code-325",
                      "tag": "astro-code",
                      "attrs": {
                        "builder-data-element": "code"
                      },
                      "children": [],
                      "html": "{aboutImage && (\n        <div class=\"overflow-hidden rounded-lg shadow-lg\">\n          <Image\n            src={aboutImage}\n            alt={`${brand.name} supporting a customer application`}\n            width={800}\n            height={600}\n            loading=\"lazy\"\n            class=\"size-full object-cover\"\n          />\n        </div>\n      )}"
                    },
                    {
                      "id": "r-div-326",
                      "tag": "div",
