                    "data-open": "<div\n      class:list={[\n        'mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:gap-14',\n        aboutImage && 'lg:grid-cols-2',\n      ]}\n    >",
                    "data-close": "</div>"
