      "route": "blog/index",
      "title": "Index",
      "root": [
        {
          "id": "r-code-3e",
          "tag": "astro-code",
          "attrs": {
            "builder-data-element": "code",
            "data-open": "<BaseLayout title=\"Blog\" description={`Notes, guides and product news from ${brand.name}.`}>",
            "data-close": "</BaseLayout>"
          },
          "children": [
            {
              "id": "r-code-37",
              "tag": "astro-code",
