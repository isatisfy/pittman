      ],
      "frontmatter": "/**\n * Base layout — wraps every page.\n *\n * Astro 6 features used:\n *  • <Font />         — built-in font optimizer from astro.config.mjs fonts array\n *  • <ClientRouter /> — client-side navigation with CSS transition animations\n */\nimport { Font } from 'astro:assets';\nimport { ClientRouter } from 'astro:transitions';\nimport '../styles/global.css';\nimport { brand } from '../config/brand';\nimport { client } from '../data/client';\n\ninterface Props {\n  title?: string;\n  description?: string;\n  image?: string;\n  schema?: Record<string, unknown>;\n}\n\nconst {\n  title = brand.name,\n  description = brand.description,\n  image = '/og-image.png',\n  schema,\n} = Astro.props;\n\nconst pageTitle = title === brand.name ? title : `${title} — ${brand.name}`;\nconst canonicalURL = new URL(Astro.url.pathname, Astro.site ?? brand.url);",
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": []
        }
      ],
      "file": "own"
    },
    "about": {
      "route": "about",
      "title": "About",
      "root": [
        {
          "id": "r-code-n",
          "tag": "astro-code",
          "attrs": {
            "builder-data-element": "code",
            "data-open": "<BaseLayout title=\"About Us\" description={`Learn about ${brand.name} — our story, team, and commitment to quality service.`}>",
            "data-close": "</BaseLayout>"
          },
          "children": [
            {
              "id": "r-code-1",
              "tag": "astro-code",
              "attrs": {
                "builder-data-element": "code"
              },
              "children": [],
              "html": "<Header slot=\"header\" />"
            },
            {
