      "frontmatter": "import BaseLayout from '../layouts/BaseLayout.astro';\nimport Header from '../components/Header.astro';\nimport Footer from '../components/Footer.astro';\nimport Banner from '../components/Banner.astro';\nimport CTA from '../components/CTA.astro';\nimport { Image } from 'astro:assets';\nimport { brand } from '../config/brand';\nimport { aboutImage } from '../config/images';\n\n/**\n * The template's \"Meet the crew\" section listed three invented people\n * (John Smith / Maria Garcia / David Chen) with stock portraits, and the story\n * used handyman copy about homeowners. Both removed. Re-add a team section\n * with real names, roles and photos when they are available.\n */",
