                  "id": "r-code-4r",
                  "tag": "astro-code",
                  "attrs": {
                    "builder-data-element": "code"
                  },
                  "children": [],
                  "html": "<!-- FOUC prevention for dark mode -->"
                },
                {
                  "id": "r-script-4s",
                  "tag": "script",
                  "html": "\n      (function(){\n        var t = localStorage.getItem('theme');\n        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {\n          document.documentElement.classList.add('dark-mode');\n        }\n      })();\n    "
                },
