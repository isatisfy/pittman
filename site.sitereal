                        "builder-data-element": "code"
                      },
                      "children": [],
                      "html": "<Image\n        src={imageSrc}\n        alt={imageAlt}\n        width={800}\n        height={600}\n        loading=\"eager\"\n        decoding=\"async\"\n        class=\"size-full object-cover\"\n      />"
