                          "html": "{reviews.map(({ quote, name, location, rating = 5 }) => (\n          <div class=\"flex flex-col rounded-lg border border-border bg-background p-6 shadow-sm\">\n            <div class=\"mb-4 flex gap-0.5\" aria-label={`Rated ${rating} out of 5 stars`}>\n              {Array.from({ length: 5 }).map((_, i) => (\n                <svg\n                  class:list={['size-5', i < rating ? 'text-accent' : 'text-border']}\n                  fill=\"currentColor\"\n                  viewBox=\"0 0 20 20\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                </svg>\n              ))}\n            </div>\n            <blockquote class=\"flex-1 text-text-muted leading-relaxed\">\n              &ldquo;{quote}&rdquo;\n            </blockquote>\n            <div class=\"mt-4 border-t border-border pt-4\">\n              <p class=\"font-semibold text-text\">{name}</p>\n              <p class=\"text-sm text-text-muted\">{location}</p>\n            </div>\n          </div>\n        ))}"
