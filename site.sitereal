              "children": [
                {
                  "id": "r-div-1d",
                  "tag": "div",
                  "classes": [
                    "mx-auto",
                    "max-w-site",
                    "px-4",
                    "sm:px-6"
                  ],
                  "children": [
                    {
                      "id": "r-div-1e",
                      "tag": "div",
                      "classes": [
                        "mx-auto",
                        "mb-10",
                        "max-w-2xl",
                        "text-center",
                        "lg:mb-14"
                      ],
                      "children": [
                        {
                          "id": "r-h2-1f",
                          "tag": "h2",
                          "classes": [
                            "font-heading",
                            "text-h2",
                            "font-bold",
                            "uppercase",
                            "text-text"
                          ],
                          "text": "How we support the channel"
                        },
                        {
                          "id": "r-p-1g",
                          "tag": "p",
                          "classes": [
                            "mt-3",
                            "text-text-muted",
                            "leading-relaxed"
                          ],
                          "text": "\n          Representation is more than a line card. Here is the work we actually do\n          between a manufacturer and the people specifying their products.\n        "
                        }
                      ]
                    },
                    {
                      "id": "r-div-1h",
                      "tag": "div",
                      "classes": [
                        "grid",
                        "grid-cols-1",
                        "gap-8",
                        "md:grid-cols-2"
                      ],
                      "children": [
                        {
                          "id": "r-code-1i",
                          "tag": "astro-code",
                          "attrs": {
                            "builder-data-element": "code"
                          },
                          "children": [],
                          "html": "{services.map((service, i) => (\n          <div class=\"flex gap-5 rounded-lg border border-border bg-background p-6 shadow-sm\">\n            <div class=\"flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\">\n              <svg class=\"size-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" set:html={icons[i % icons.length]} />\n            </div>\n            <div>\n              <h3 class=\"font-heading text-h3 font-semibold text-text\">{service.title}</h3>\n              <p class=\"mt-2 text-text-muted leading-relaxed\">{service.description}</p>\n            </div>\n          </div>\n        ))}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "r-code-1j",
              "tag": "astro-code",
