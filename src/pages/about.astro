---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { aboutImage } from '../config/images';

/**
 * The template's "Meet the crew" section listed three invented people
 * (John Smith / Maria Garcia / David Chen) with stock portraits, and the story
 * used handyman copy about homeowners. Both removed. Re-add a team section
 * with real names, roles and photos when they are available.
 */
---

<BaseLayout title="About Us" description={`Learn about ${brand.name} — the lines we represent, the territory we cover, and how we support the channel.`}>
  <Header slot="header" />

  <Banner title="About Us" />

  <!-- Story -->
  <section class="py-section">
    <div
      class:list={[
        'mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:gap-14',
        aboutImage && 'lg:grid-cols-2',
      ]}
    >
      {aboutImage && (
        <div class="overflow-hidden rounded-lg shadow-lg">
          <Image
            src={aboutImage}
            alt={`${brand.name} supporting a customer application`}
            width={800}
            height={600}
            loading="lazy"
            class="size-full object-cover"
          />
        </div>
      )}
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent-ink">Our Story</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Built on relationships, driven by application expertise</h2>
        <p class="text-text-muted leading-relaxed">
          {brand.name} is an industrial manufacturers representative covering the
          mid to southern Atlantic and Gulf Coast. We connect the manufacturers we
          represent with the distributors and end users who need them — and we stay
          involved long after the introduction.
        </p>
        <p class="text-text-muted leading-relaxed">
          Our work is supply chain intelligence, channel support, training and
          product application: the detail work that lowers a customer's cost per
          unit rather than simply moving a line item.
        </p>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
