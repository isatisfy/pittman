---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import { brand, brandNameSentence } from '../../config/brand';
import { client } from '../../data/client';
---

<BaseLayout title="Contact" description={`Get in touch with ${brandNameSentence} Request a quote or ask us about an application.`}>
  <Header slot="header" />

  <Banner title="Contact Us" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14">

      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Send us a message</h2>
        <p class="mt-2 mb-8 text-text-muted">
          Fill out the form below and we'll get back to you within one business day.
        </p>

        <!--
          Revealed by the script at the foot of this file when the handler
          sends the visitor back with ?error. It cannot be rendered server-side
          because this page is static HTML: there is no request to read the
          query string from. It names the phone number and address on purpose,
          so a failure is a detour rather than a dead end.
        -->
        <div
          id="contact-error"
          role="alert"
          tabindex="-1"
          class="mb-6 hidden rounded-md border border-accent-ink/40 bg-accent/10 p-4"
        >
          <p class="text-sm font-bold text-text">That message didn&rsquo;t send.</p>
          <p class="mt-1.5 text-sm text-text-muted">
            Something went wrong at our end — please try again. If it keeps failing, call
            <a href={`tel:${client.phoneForTel}`} class="font-medium text-primary underline underline-offset-2">{client.phoneFormatted}</a>
            or email
            <a href={`mailto:${client.email}`} class="font-medium text-primary underline underline-offset-2">{client.email}</a>.
          </p>
        </div>

        <!--
          Posts to a Vercel serverless function (api/contact.js), NOT to
          Netlify Forms, which is what carried this form before the move to
          Vercel. The function redirects to /contact/success when the message
          is away and back here with ?error=send when it is not, so the form
          still needs no JavaScript in order to work.
        -->
        <form
          name="contact"
          method="POST"
          action="/api/contact"
          class="flex flex-col gap-5"
        >
          <!--
            Honeypot. Spam bots fill in every field they find; api/contact.js
            drops any submission that arrives with a value in this one. Kept
            from both sight and assistive tech.
          -->
          <p class="hidden" aria-hidden="true">
            <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Name <span class="text-accent-ink" aria-hidden="true">*</span></span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Email <span class="text-accent-ink" aria-hidden="true">*</span></span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Phone</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Message <span class="text-accent-ink" aria-hidden="true">*</span></span>
            <textarea
              name="message"
              rows="5"
              required
              class="min-h-[120px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-y"
            ></textarea>
          </label>

          <button
            type="submit"
            class="mt-2 inline-flex min-h-[44px] cursor-pointer items-center justify-center self-start rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-ink"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact info sidebar -->
      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Call Us</h3>
          <a href={`tel:${client.phoneForTel}`} class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary">
            {client.phoneFormatted}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Email Us</h3>
          <a href={`mailto:${client.email}`} class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary">
            {client.email}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Visit Us</h3>
          <a
            href={client.address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-text-muted transition-colors hover:text-text"
          >
            {client.address.lineOne}<br />
            {client.address.lineTwo && <>{client.address.lineTwo}<br /></>}
            {client.address.city}, {client.address.state} {client.address.zip}
          </a>
        </div>

        {/*
          The template's Hours block advertised 7am–6pm weekdays, Saturday
          hours and "24/7 Emergency Service Available" — invented, and wrong
          for a representative firm. Removed rather than publish made-up hours.
          Add it back once the real hours are confirmed.
        */}
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  /**
   * Show the failure notice when api/contact.js has sent the visitor back
   * with ?error. This page is static, so the query string can only be read
   * here, in the browser.
   *
   * Focus moves to the notice rather than merely scrolling to it: the visitor
   * pressed Send and arrived somewhere new, so a screen reader needs to be
   * told why, and a sighted visitor needs their eye taken to it.
   */
  function syncContactError() {
    const alert = document.getElementById('contact-error');
    if (!alert) return;

    const failed = new URLSearchParams(window.location.search).has('error');
    alert.classList.toggle('hidden', !failed);
    if (failed) alert.focus();
  }

  syncContactError();
  document.addEventListener('astro:after-swap', syncContactError);
</script>
