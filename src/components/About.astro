---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { aboutImage as localAboutImage } from '../config/images';

// No stock fallback: when no local about image is registered in
// src/config/images.ts the image column is omitted and the copy goes
// full width, rather than shipping an unrelated Unsplash photo.
interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = 'Who We Are',
  heading = 'A representative, not just a line card',
  body = [
    'We represent industrial manufacturers across the mid to southern Atlantic and Gulf Coast, connecting them with the distributors and end users who put their products to work.',
    'The value is in what happens after the introduction: knowing where supply actually stands, training the people who specify the product, and getting the application right the first time.',
  ],
  benefits = [
    'Supply chain intelligence on the lines we represent',
    'Training for distributor and end-user teams',
    'Application support that lowers cost per unit',
  ],
  ctaLabel = 'More About Us',
  ctaHref = '/about',
  imageSrc = localAboutImage,
  imageAlt = 'Industrial components on a production floor',
} = Astro.props;
---

<section class="py-section">
  <div
    class:list={[
      'mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:gap-14',
      imageSrc && 'lg:grid-cols-2',
    ]}
  >

    <!-- Image -->
    {imageSrc && (
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src={imageSrc}
          alt={imageAlt}
          width={700}
          height={525}
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
    )}

    <!-- Content -->
    <div class="space-y-5">
      <span class="text-topper font-bold uppercase tracking-widest text-accent-ink">{topper}</span>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

      {body.map((paragraph) => (
        <p class="text-text-muted leading-relaxed">{paragraph}</p>
      ))}

      <!-- Benefits list -->
      <ul class="space-y-3 pt-2" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 size-5 shrink-0 text-accent-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
