---
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { client } from '../data/client';
import { logoImage } from '../config/images';

const nav = [
  { label: 'Home',     href: '/' },
  { label: 'About',    href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Reviews',  href: '/reviews' },
  { label: 'Blog',     href: '/blog' },
  { label: 'Contact',  href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<!--
  transition:persist is NAMED on purpose. Left bare, Astro generates the id
  from the component's position on the page - the homepage produced
  "astro-l7r54iwe-4" while every inner page produced "astro-l7r54iwe-2".
  Astro matches persisted elements by that exact string, so the header
  persisted between inner pages but not from the homepage, and the active-link
  highlight stuck on whichever inner page was visited first. A fixed name
  matches everywhere.
-->
<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
  transition:persist="site-header"
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center transition-opacity hover:opacity-80">
      {/* alt carries the business name, so it is also this link's accessible name. */}
      <Image
        src={logoImage}
        alt={brand.name}
        width={173}
        height={40}
        densities={[1, 2]}
        loading="eager"
        class="h-8 w-auto sm:h-10"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {nav.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA + phone -->
    <div class="hidden items-center gap-4 lg:flex">
      {client.license && (
        <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-muted">
          {client.license}
        </span>
      )}
      <a
        href={`tel:${client.phoneForTel}`}
        class="text-sm font-semibold text-text hover:text-primary transition-colors"
      >
        {client.phoneFormatted}
      </a>
      <a
        href="/contact"
        class="inline-flex min-h-[44px] items-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-ink"
      >
        Contact Us Now
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {nav.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'rounded-md px-3 py-3 text-base font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text hover:bg-surface',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
      >
        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {client.phoneFormatted}
      </a>
      <a
        href="/contact"
        class="flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
      >
        Contact Us Now
      </a>
      {client.license && (
        <p class="px-3 pt-1 text-xs text-text-muted">{client.license}</p>
      )}
    </div>
  </div>
</header>

<script>
  /**
   * The mobile drawer, and the highlight on the current page's nav link.
   *
   * WHY THIS IS SHAPED THE WAY IT IS
   * The header is transition:persist, so on a client-side navigation Astro
   * keeps THIS element and discards the one the incoming page rendered. The
   * server-rendered highlight is therefore only ever correct on a full page
   * load; after that, this script is the only thing that can move it.
   *
   * The previous version captured the header in a closure at startup. Once
   * that element was swapped out, every later sync wrote to a detached node
   * and the highlight stopped moving - it stuck on whichever page was opened
   * first. An early return on a `menuInit` flag meant re-running the script
   * could not recover either. So: look the header up fresh on every call and
   * never hold on to one, and keep the one-time listener binding separate
   * from the per-navigation sync.
   */
  (() => {
    const ACTIVE = ['bg-primary/10', 'text-primary'];
    const INACTIVE_DESKTOP = ['text-text-muted', 'hover:text-text'];
    const INACTIVE_MOBILE = ['text-text-muted', 'hover:text-text', 'hover:bg-surface'];

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    /** Read the header and its parts out of the live document. Never cached. */
    function parts() {
      const header = document.querySelector('header');
      const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      if (!header || !btn || !menu || !iconOpen || !iconClose) return null;
      return { header, btn, menu, iconOpen, iconClose };
    }

    function setMenuOpen(nextOpen: boolean) {
      const p = parts();
      if (!p) return;
      // Hard stop: hamburger/drawer behavior is mobile-only.
      if (isDesktop()) nextOpen = false;
      p.btn.setAttribute('aria-expanded', String(nextOpen));
      p.menu.classList.toggle('hidden', !nextOpen);
      p.iconOpen.classList.toggle('hidden', nextOpen);
      p.iconClose.classList.toggle('hidden', !nextOpen);
    }

    function mark(link: Element, active: boolean, inactive: string[]) {
      link.classList.toggle(ACTIVE[0], active);
      link.classList.toggle(ACTIVE[1], active);
      for (const cls of inactive) link.classList.toggle(cls, !active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }

    function syncActiveLinks() {
      const p = parts();
      if (!p) return;
      const path = window.location.pathname;

      // Same rule as the server-rendered pass in this component's frontmatter.
      // Keep the two in step, or the highlight will shift on first navigation.
      const isActive = (link: Element) => {
        const href = link.getAttribute('href') || '';
        return href === path || (href !== '/' && path.startsWith(href));
      };

      p.header
        .querySelectorAll('nav[aria-label="Primary navigation"] a')
        .forEach((link) => mark(link, isActive(link), INACTIVE_DESKTOP));

      p.header
        .querySelectorAll('#mobile-menu nav a')
        .forEach((link) => mark(link, isActive(link), INACTIVE_MOBILE));
    }

    /**
     * Safe to call repeatedly. Click handlers bind once per header ELEMENT -
     * a persisted header keeps the ones it has, a freshly rendered one gets
     * its own - while the sync runs every time, which is the part that has to
     * happen after each navigation.
     */
    function wire() {
      const p = parts();
      if (!p) return;

      if (p.header.dataset.menuInit !== 'true') {
        p.header.dataset.menuInit = 'true';

        p.btn.addEventListener('click', () => {
          if (isDesktop()) return;
          setMenuOpen(p.btn.getAttribute('aria-expanded') !== 'true');
        });

        p.menu.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('a[href]')) setMenuOpen(false);
        });
      }

      setMenuOpen(false);
      syncActiveLinks();
    }

    document.addEventListener('astro:before-preparation', () => setMenuOpen(false));
    document.addEventListener('astro:after-swap', wire);

    // Ensure mobile drawer can't stay open if viewport changes to desktop.
    window.addEventListener('resize', () => setMenuOpen(false));

    wire();
  })();
</script>
